# Copy file này thành .env rồi điền giá trị (file .env KHÔNG được commit lên Git).

# Khóa ký cookie phiên của Flask - đặt chuỗi ngẫu nhiên dài khi deploy
SECRET_KEY=

# --- Firebase Authentication (Firebase Console > Project settings > General > Your apps > Web app) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Bỏ trống thì dùng <FIREBASE_PROJECT_ID>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# --- Firestore (Project settings > Service accounts > Generate new private key) ---
# Dev: đường dẫn tới file JSON. Deploy: dùng FIREBASE_CREDENTIALS_JSON (nội dung JSON).
FIREBASE_CREDENTIALS=serviceAccount.json
